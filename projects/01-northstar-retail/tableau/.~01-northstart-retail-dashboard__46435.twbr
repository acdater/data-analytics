      <source dashboard='Northstar Profitability Overview' type='sheet' worksheet='category_sales_sheet' />
      <link caption='Filter Profit by Selected Category' delimiter=',' escape='\' expression='tsl:Northstar%20Profitability%20Overview?%5Bfederated.161n2zz1lny3ik13c1wu60158daj%5D.%5Bcategory_name%5D~s0=&lt;[federated.161n2zz1lny3ik13c1wu60158daj].[category_name]~na&gt;' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='net_sales_sheet,gross_profit_sheet,cogs_sheet,category_sales_sheet,gross_margin_sheet' />
