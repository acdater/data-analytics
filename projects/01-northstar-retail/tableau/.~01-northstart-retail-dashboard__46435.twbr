      <aliases enabled='yes' />
      <column caption='gross margin %' datatype='real' default-format='n#,##0.00&quot;%&quot;;-#,##0.00&quot;%&quot;' name='[Calculation_2803197486571520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gross_profit]) / SUM([net_sales]) * 100' />
      </column>
      <column caption='Net Sales YoY %' datatype='real' default-format='p0.00%' name='[Calculation_2803197564854273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF YEAR([month]) = 2025&#10;    THEN [net_sales]&#10;    END&#10;) /&#10;SUM(&#10;    IF YEAR([month]) = 2024&#10;    THEN [net_sales]&#10;    END&#10;) - 1' />
      </column>
      <column caption='Net Sales 2025' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_2803197567094786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([month]) = 2025&#10;THEN [net_sales]&#10;END' />
      </column>
      <column caption='COGS YoY %' datatype='real' default-format='p0.00%' name='[Calculation_3191051254308864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF YEAR([month]) = 2025&#10;    THEN [cogs]&#10;    END&#10;) /&#10;SUM(&#10;    IF YEAR([month]) = 2024&#10;    THEN [cogs]&#10;    END&#10;) - 1' />
      </column>
      <column caption='COGS 2025' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_3191051255021569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([month]) == 2025&#10;THEN [cogs]&#10;END' />
      </column>
      <column caption='Gross Profit 2025' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_3191051256963074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([month]) == 2025&#10;THEN [gross_profit]&#10;END' />
      </column>
      <column caption='Gross Profit YoY 2025' datatype='real' default-format='p0.00%' name='[Calculation_3191051257364483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3191051256963074]) /&#10;SUM((IF YEAR([month]) == 2024 THEN [gross_profit] END))&#10;- 1' />
      </column>
      <column caption='gross margin 2025 %' datatype='real' name='[Calculation_3191051259604996]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3191051256963074]) / SUM([Calculation_2803197567094786]) * 100' />
      </column>
      <column caption='gross margin 2024 %' datatype='real' name='[Calculation_3191051259748357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([month]) == 2024 THEN [gross_profit] END) &#10;/ &#10;SUM(IF YEAR([month]) == 2024 THEN [net_sales] END)&#10;* 100' />
      </column>
      <column caption='gross margin YoY pp' datatype='real' default-format='n#,##0.00&quot; pp&quot;;-#,##0.00&quot; pp&quot;' name='[Calculation_3191051260125190]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3191051259604996] - [Calculation_3191051259748357]' />
      </column>
      <column caption='Net Sales YoY Status' datatype='string' name='[Calculation_3191051273101319]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2803197564854273] &gt; 0 THEN &quot;Positive&quot;&#10;ELSEIF [Calculation_2803197564854273] &lt; 0 THEN &quot;Negative&quot;&#10;ELSE &quot;Neutral&quot;&#10;END' />
