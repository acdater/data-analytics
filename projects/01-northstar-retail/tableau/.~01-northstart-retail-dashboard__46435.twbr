              <calculation class='tableau' formula='SUM(&#10;    IF YEAR([month]) = 2025&#10;    THEN [net_sales]&#10;    END&#10;) /&#10;SUM(&#10;    IF YEAR([month]) = 2024&#10;    THEN [net_sales]&#10;    END&#10;) - 1' />
